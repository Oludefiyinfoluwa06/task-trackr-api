PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/task-trackr

# SMTP (optional). If not set, the server will use an Ethereal test account and print a preview URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@tasktrackr.local

# JWT settings
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=7d
